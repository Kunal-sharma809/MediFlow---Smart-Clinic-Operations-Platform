# Application Settings
PROJECT_NAME="Stock Market Signal Intelligence Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=true

# Server Settings
HOST="0.0.0.0"
PORT=8000
ALLOWED_CORS_ORIGINS="http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173"

# Security & JWT Auth
SECRET_KEY="PRODUCTION_SUPER_SECRET_KEY_CHANGE_THIS_IN_PROD_1234567890"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_DB="stock_signal_db"
DATABASE_URL="postgresql+asyncpg://postgres:postgres_password@localhost:5432/stock_signal_db"

# Redis Cache & Message Broker
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# Celery Worker
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/1"

# External Data APIs
ALPHA_VANTAGE_API_KEY=""
POLYGON_API_KEY=""
